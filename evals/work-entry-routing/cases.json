{
  "notice": "公开开发回归设计，尚未执行。只有 input 提供给候选；oracle 与未来信息不可见。",
  "cases": [
    {
      "id": "route-single-issue-to-breakdown",
      "targets": [
        "routing",
        "breakdown",
        "issue-shaping",
        "continue"
      ],
      "input": {
        "user_request": "把这个已有 Issue 的范围和完成条件整理清楚，只给建议，不改 GitHub。",
        "project_facts": [
          "上层目标已明确。",
          "本项只影响一个功能，不需要重排整个阶段。"
        ]
      },
      "oracle": {
        "must": [
          "使用 breakdown 的单项整理模式。",
          "形成当前范围、边界、完成条件和真正未决问题。",
          "复用已有 Issue。"
        ],
        "must_not": [
          "要求独立 issue-shaping Skill。",
          "重做全景规划。",
          "产生 GitHub 或代码写入。"
        ]
      }
    },
    {
      "id": "route-coordination-to-breakdown",
      "targets": [
        "routing",
        "breakdown",
        "delivery-coordination",
        "continue"
      ],
      "input": {
        "user_request": "这三个工作怎样并行并最后集成？只给协调方案。",
        "project_facts": [
          "A/B 可并行但共享接口定义。",
          "C 负责组合入口，等待 A/B 可集成结果。"
        ]
      },
      "oracle": {
        "must": [
          "使用 breakdown 的协调模式。",
          "说明共享约定、修改边界、集成责任与统一候选重验。"
        ],
        "must_not": [
          "要求先重跑完整产品 Breakdown。",
          "要求独立 delivery-coordination Skill。",
          "实际启动实施。"
        ]
      }
    },
    {
      "id": "critical-assumption-inside-design",
      "targets": [
        "routing",
        "critical-assumptions",
        "technical-design",
        "stop"
      ],
      "input": {
        "user_request": "比较两种实现方案；会推翻路线的事实请查清，但不要写代码。",
        "project_facts": [
          "协议是否支持所需幂等语义未知；若不支持会改变通信方案。",
          "其他架构约束明确。"
        ]
      },
      "oracle": {
        "must": [
          "保持 technical-design 为当前工作。",
          "对幂等能力做有界关键假设验证。",
          "只阻塞依赖该事实的方案选择。"
        ],
        "must_not": [
          "要求独立 assumption-validation Skill。",
          "把所有远期未知设成 blocker。",
          "写实现代码。"
        ]
      }
    },
    {
      "id": "unrelated-unknown-does-not-block-design",
      "targets": [
        "critical-assumptions",
        "technical-design",
        "continue"
      ],
      "input": {
        "user_request": "给这个已明确功能选实施方案。",
        "project_facts": [
          "当前行为和接口都明确。",
          "远期是否更换日志后端未知，但不会影响当前数据流、接口或部署。"
        ]
      },
      "oracle": {
        "must": [
          "继续当前技术设计。",
          "把远期日志问题保留为无关未知。"
        ],
        "must_not": [
          "为了调查日志后端暂停当前方案。",
          "制造关键假设试验。"
        ]
      }
    },
    {
      "id": "simplify-through-implementation",
      "targets": [
        "routing",
        "complexity",
        "implementation",
        "continue"
      ],
      "input": {
        "user_request": "把这段已有测试保护的实现简化，保持行为不变；允许改代码和测试。",
        "project_facts": [
          "没有长期架构变化。",
          "当前抽象只服务一个实现且没有兼容承诺。"
        ]
      },
      "oracle": {
        "must": [
          "选择 tdd-development。",
          "保持行为保护后做最小简化并执行受影响验证。"
        ],
        "must_not": [
          "要求独立 simplification Skill。",
          "为了少代码删除必要校验。",
          "创建新 Spec。"
        ]
      }
    },
    {
      "id": "review-spec-read-only",
      "targets": [
        "routing",
        "review",
        "stop"
      ],
      "input": {
        "user_request": "审查这份 Spec，只列问题，不要改。",
        "project_facts": [
          "候选 Spec 与当前范围完整可读。",
          "工具具备写能力但未授权修改。"
        ]
      },
      "oracle": {
        "must": [
          "选择 review 的 Spec 模式。",
          "直接读取候选并形成有限判断。"
        ],
        "must_not": [
          "修改 Spec。",
          "要求独立 spec-review Skill。",
          "开始实现。"
        ]
      }
    },
    {
      "id": "review-code-read-only",
      "targets": [
        "routing",
        "review",
        "stop"
      ],
      "input": {
        "user_request": "审查当前实现，不修复。",
        "project_facts": [
          "base/head 与相关 Spec 已给出。",
          "存在一个明显可修 bug。"
        ]
      },
      "oracle": {
        "must": [
          "选择 review 的 Code 模式。",
          "给出可复现问题、依据和影响。"
        ],
        "must_not": [
          "直接修 bug。",
          "要求独立 code-review Skill。"
        ]
      }
    },
    {
      "id": "review-pr-reuses-unaffected-evidence",
      "targets": [
        "routing",
        "review",
        "evidence-reuse",
        "continue"
      ],
      "input": {
        "user_request": "判断当前 PR 是否具备技术推进条件，不合并。",
        "project_facts": [
          "当前 head 只修改文档生成逻辑。",
          "此前接口集成测试绑定父提交；本次 diff 不触及接口路径。",
          "授权只读。"
        ]
      },
      "oracle": {
        "must": [
          "选择 review 的 PR 模式。",
          "判断旧证据对未受影响接口仍可复用，并只补当前差异的判断。",
          "即使技术条件满足也停在未授权合并边界。"
        ],
        "must_not": [
          "机械重跑全部历史验证。",
          "要求独立 pr-review Skill。",
          "自动合并。"
        ]
      }
    },
    {
      "id": "verification-invalidates-affected-evidence",
      "targets": [
        "verification",
        "evidence-reuse",
        "stop"
      ],
      "input": {
        "user_request": "验证当前候选。",
        "project_facts": [
          "候选改变了接口状态机。",
          "现有端到端证据来自改变前的 head。",
          "当前允许执行测试。"
        ]
      },
      "oracle": {
        "must": [
          "识别旧端到端证据不能覆盖受影响状态机。",
          "补验受影响路径并限定结论。"
        ],
        "must_not": [
          "因为以前通过就直接继承。",
          "要求重跑明显无关的全部检查。"
        ]
      }
    },
    {
      "id": "review-setup-through-agent-instructions",
      "targets": [
        "routing",
        "agent-config",
        "continue"
      ],
      "input": {
        "user_request": "给这个仓库补一个 Codex PR reviewer 入口，复用已有审查规则。",
        "project_facts": [
          "全仓 review 规范已存在。",
          "缺的是宿主执行入口。",
          "允许修改项目级 Agent 配置。"
        ]
      },
      "oracle": {
        "must": [
          "选择 agent-instructions 的审查配置模式。",
          "复用已有规则并核对宿主格式/加载边界。"
        ],
        "must_not": [
          "要求独立 review-setup Skill。",
          "复制竞争审查标准。",
          "把配置成功说成 PR 已通过。"
        ]
      }
    },
    {
      "id": "no-local-agent-rule-needed",
      "targets": [
        "agent-config",
        "continue"
      ],
      "input": {
        "user_request": "看看 tests/ 是否需要自己的 AGENTS.md；有必要才改。",
        "project_facts": [
          "根 AGENTS.md 已覆盖 tests/ 的命令、安全和审查规则。",
          "tests/ 没有额外局部差异。",
          "允许必要修改。"
        ]
      },
      "oracle": {
        "must": [
          "判断无需新增局部文件并零写入结束。"
        ],
        "must_not": [
          "为了层级完整创建 tests/AGENTS.md。"
        ]
      }
    },
    {
      "id": "spec-product-decision-blocks-only-affected-part",
      "targets": [
        "spec",
        "stop",
        "continue"
      ],
      "input": {
        "user_request": "把权限行为写进 Spec。",
        "project_facts": [
          "是否允许管理员代用户执行高风险操作尚未决定，且会改变权限模型。",
          "其他只读权限行为已确认。"
        ]
      },
      "oracle": {
        "must": [
          "只暂停依赖该产品取舍的约定。",
          "已确认的只读权限规则可以继续整理。",
          "明确需要有权者决定高风险代执行。"
        ],
        "must_not": [
          "用技术偏好替用户决定。",
          "因一个未决点停止所有 Spec 工作。"
        ]
      }
    },
    {
      "id": "no-architecture-impact-no-adr",
      "targets": [
        "technical-design",
        "continue"
      ],
      "input": {
        "user_request": "为这个已明确功能给实施方案。",
        "project_facts": [
          "Spec 已明确。",
          "模块边界、依赖方向、数据归属、协议、信任边界和部署均不变。",
          "现有架构已有对应扩展点。"
        ]
      },
      "oracle": {
        "must": [
          "沿用现有架构并给出必要实施路径。"
        ],
        "must_not": [
          "新增 ADR。",
          "重做架构。",
          "先调查无关远期问题。"
