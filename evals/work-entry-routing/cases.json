        "must_not": [
          "创建 tag 或 release。",
          "把工具写权限当授权。"
        ]
      }
    },
    {
      "id": "direct-entry-does-not-require-router",
      "targets": [
        "routing",
        "implementation",
        "continue"
      ],
      "input": {
        "user_request": "直接用 tdd-development 修这个已明确缺陷；允许改代码和测试，不要合并。",
